{
  "name": "home-budget",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite app",
    "build": "tsc -p tsconfig.json --noEmit && vite build app",
    "preview": "vite preview app",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-home-budget \"vitest run -c vitest.rules.config.ts\"",
    "budget:publish": "tsx scripts/publish-budget.ts",
    "export": "tsx scripts/export.ts",
    "rules": "tsx scripts/build-rules.ts",
    "share": "tsx scripts/share.ts",
    "icons": "pwa-assets-generator --preset minimal-2023 app/public/icon.svg"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "firebase": "^12.19.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
