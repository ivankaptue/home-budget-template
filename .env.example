# Copy to .env (git-ignored) and fill in with your own Firebase project.
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
# The web config is public by design (it ends up in the built app); access is enforced by the Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Subtitle on the sign-in screen and in the installed app description (optional).
VITE_APP_TAGLINE=Le budget de la maison

# Google accounts allowed to read and write (verified emails), comma-separated.
# Never committed: `npm run rules` writes them into firebase/firestore.rules before each deploy.
ALLOWED_EMAILS=

# Optional, for `npm run share`: extra words that must not appear in the shared copy (names…), comma-separated.
SHARE_FORBIDDEN=
